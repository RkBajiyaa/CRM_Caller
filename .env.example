# Conbun CRM -- environment variable template.
#
# Convention: copy this file to `.env` and fill in real values there.
# `.env` is gitignored and must never be committed; `.env.example` is the
# committed, always-up-to-date list of what variables exist and their shape
# (placeholder values only -- never real credentials).
#
# Next.js loads `.env`/`.env.local` automatically. The standalone Prisma CLI
# (schema/migrations, run outside `next dev`) loads `.env` via
# `prisma.config.ts`'s `import "dotenv/config"` -- see that file.

# --- Database ----------------------------------------------------------------
# Neon Postgres connection string. Get this from the Neon project dashboard
# (Connection Details -> "Prisma" or "pooled connection" string).
# STATUS: connected and migrated -- see CHANGELOG.md for the migration record.
DATABASE_URL="postgresql://<user>:<password>@<neon-project>.neon.tech/<database>?sslmode=require"

# --- Auth ----------------------------------------------------------------------
# HS256 signing secret for backend-issued JWTs (agents + Android), verified
# by lib/auth/jwt.ts and app's middleware.ts. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate before any real deployment -- rotating invalidates all existing
# sessions/tokens (stateless JWT, no server-side revocation list in V1).
JWT_SECRET="<generate-a-random-secret-and-put-it-here>"
